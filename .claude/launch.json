{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@pw/web"],
      "port": 5173
    },
    {
      "name": "metro",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/mobile && exec npx expo start --dev-client --port 8081"],
      "port": 8081
    },
    {
      "name": "sync-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@pw/server"],
      "port": 8787
    }
  ]
}
